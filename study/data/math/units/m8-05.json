{
  "id": "m8-05",
  "subject": "math",
  "grade": 8,
  "order": 5,
  "title": "乘法公式",
  "codes": [
    {
      "code": "A-8-1",
      "text": "二次式的乘法公式：(a+b)²=a²+2ab+b²；(a−b)²=a²−2ab+b²；(a+b)(a−b)=a²−b²；(a+b)(c+d)=ac+ad+bc+bd。"
    }
  ],
  "intro": "四個乘法公式讓展開與速算變快：和的平方、差的平方、平方差、分配律展開。會考常考展開、速算，以及含根號的化簡。",
  "sections": [
    {
      "title": "和的平方與差的平方",
      "points": [
        "$(a+b)^2=a^2+2ab+b^2$；$(a-b)^2=a^2-2ab+b^2$。",
        "中間項是 $2ab$，不能漏掉：$(a+b)^2\\ne a^2+b^2$。",
        "例：$(2a-3)^2=(2a)^2-2\\times 2a\\times 3+3^2=4a^2-12a+9$。",
        "從正方形面積看：邊長 $a+b$ 的大正方形，切成 $a^2$、$b^2$ 和兩塊 $ab$。"
      ],
      "svg": "<svg viewBox=\"0 0 250 230\" xmlns=\"http://www.w3.org/2000/svg\" font-size=\"15\"><rect x=\"30\" y=\"20\" width=\"120\" height=\"120\" class=\"soft\" stroke=\"currentColor\"/><rect x=\"150\" y=\"20\" width=\"60\" height=\"120\" fill=\"none\" stroke=\"currentColor\"/><rect x=\"30\" y=\"140\" width=\"120\" height=\"60\" fill=\"none\" stroke=\"currentColor\"/><rect x=\"150\" y=\"140\" width=\"60\" height=\"60\" class=\"soft2\" stroke=\"currentColor\"/><text x=\"80.0\" y=\"85.0\">a²</text><text x=\"170.0\" y=\"85.0\">ab</text><text x=\"80.0\" y=\"175.0\">ab</text><text x=\"170.0\" y=\"175.0\">b²</text><text x=\"86.0\" y=\"15\">a</text><text x=\"176.0\" y=\"15\">b</text><text x=\"14\" y=\"85.0\">a</text><text x=\"14\" y=\"175.0\">b</text></svg>",
      "caption": "邊長 a+b 的正方形 = a² + 2ab + b²"
    },
    {
      "title": "平方差",
      "points": [
        "$(a+b)(a-b)=a^2-b^2$：兩數和乘以兩數差，等於平方相減。",
        "例：$(x+5)(x-5)=x^2-25$。",
        "含根號：$(\\sqrt{5}+\\sqrt{2})(\\sqrt{5}-\\sqrt{2})=5-2=3$。"
      ]
    },
    {
      "title": "分配律展開",
      "points": [
        "$(a+b)(c+d)=ac+ad+bc+bd$：前括號每一項都要乘到後括號每一項。",
        "例：$(x+3)(2x-5)=2x^2-5x+6x-15=2x^2+x-15$。",
        "展開後記得合併同類項，並注意負號。"
      ]
    },
    {
      "title": "速算與應用",
      "points": [
        "$103\\times 97=(100+3)(100-3)=10000-9=9991$。",
        "$199^2=(200-1)^2=40000-400+1=39601$。",
        "已知 $a+b$ 和 $ab$，可求 $a^2+b^2=(a+b)^2-2ab$。",
        "含根號：$(\\sqrt{3}+1)^2=3+2\\sqrt{3}+1=4+2\\sqrt{3}$。"
      ]
    }
  ],
  "mustKnow": [
    {
      "name": "和的平方",
      "body": "$(a+b)^2=a^2+2ab+b^2$"
    },
    {
      "name": "差的平方",
      "body": "$(a-b)^2=a^2-2ab+b^2$"
    },
    {
      "name": "平方差",
      "body": "$(a+b)(a-b)=a^2-b^2$"
    },
    {
      "name": "分配律",
      "body": "$(a+b)(c+d)=ac+ad+bc+bd$"
    },
    {
      "name": "平方和變形",
      "body": "$a^2+b^2=(a+b)^2-2ab$"
    }
  ],
  "quiz": [
    {
      "id": "m8-05-q01",
      "level": 1,
      "tier": "basic",
      "concept": "和的平方",
      "q": "展開 $(x+5)^2$ 的結果是什麼？",
      "choices": [
        "$x^2+25$",
        "$x^2+10x+25$",
        "$x^2+5x+25$",
        "$x^2+10x+10$"
      ],
      "answer": 1,
      "explain": "$(x+5)^2=x^2+2\\times x\\times 5+5^2=x^2+10x+25$。$x^2+25$ 漏了中間項，$x^2+5x+25$ 中間項少乘 2。答案是 $x^2+10x+25$。",
      "codes": [
        "A-8-1"
      ]
    },
    {
      "id": "m8-05-q02",
      "level": 1,
      "tier": "basic",
      "concept": "平方差公式",
      "q": "利用乘法公式計算 $103\\times 97$ 的值。",
      "choices": [
        "$10009$",
        "$9999$",
        "$9981$",
        "$9991$"
      ],
      "answer": 3,
      "explain": "$103\\times 97=(100+3)(100-3)=100^2-3^2=10000-9=9991$。$10009$ 是把減號寫成加號。答案是 $9991$。",
      "codes": [
        "A-8-1"
      ]
    },
    {
      "id": "m8-05-q03",
      "level": 1,
      "tier": "basic",
      "concept": "差的平方",
      "q": "展開 $(2a-3)^2$ 的結果是什麼？",
      "choices": [
        "$4a^2-12a+9$",
        "$4a^2-9$",
        "$4a^2-6a+9$",
        "$2a^2-12a+9$"
      ],
      "answer": 0,
      "explain": "$(2a-3)^2=(2a)^2-2\\times 2a\\times 3+3^2=4a^2-12a+9$。$4a^2-9$ 是誤用平方差，$2a^2$ 是忘了把 2 也平方。答案是 $4a^2-12a+9$。",
      "codes": [
        "A-8-1"
      ]
    },
    {
      "id": "m8-05-q04",
      "level": 2,
      "tier": "exam",
      "concept": "平方差公式",
      "q": "利用乘法公式計算 $199^2$ 的值。",
      "choices": [
        "$39999$",
        "$40401$",
        "$39601$",
        "$39401$"
      ],
      "answer": 2,
      "explain": "$199^2=(200-1)^2=200^2-2\\times 200\\times 1+1^2=40000-400+1=39601$。$39999$ 是誤用 $200^2-1^2$，$40401$ 是 $201^2$。答案是 $39601$。",
      "codes": [
        "A-8-1"
      ]
    },
    {
      "id": "m8-05-q05",
      "level": 2,
      "tier": "exam",
      "concept": "平方差公式",
      "q": "計算 $(\\sqrt{5}+\\sqrt{2})(\\sqrt{5}-\\sqrt{2})$ 的值。",
      "choices": [
        "$7$",
        "$3$",
        "$\\sqrt{3}$",
        "$3-2\\sqrt{10}$"
      ],
      "answer": 1,
      "explain": "用平方差：$(\\sqrt{5})^2-(\\sqrt{2})^2=5-2=3$。$7$ 是把減號當加號，$\\sqrt{3}$ 是平方後又開了根號。答案是 $3$。",
      "codes": [
        "A-8-1"
      ]
    },
    {
      "id": "m8-05-q06",
      "level": 2,
      "tier": "exam",
      "concept": "分配律展開",
      "q": "展開 $(x+3)(2x-5)$ 的結果是什麼？",
      "choices": [
        "$2x^2-x-15$",
        "$2x^2-15$",
        "$2x^2+11x-15$",
        "$2x^2+x-15$"
      ],
      "answer": 3,
      "explain": "$(x+3)(2x-5)=2x^2-5x+6x-15=2x^2+x-15$。$2x^2-15$ 漏了交叉兩項，$2x^2+11x-15$ 是把 $-5x$ 的負號弄丟。答案是 $2x^2+x-15$。",
      "codes": [
        "A-8-1"
      ]
    },
    {
      "id": "m8-05-q07",
      "level": 3,
      "tier": "exam",
      "concept": "乘法公式變形",
      "q": "已知 $a+b=7$、$ab=10$，則 $a^2+b^2$ 是多少？",
      "choices": [
        "$29$",
        "$39$",
        "$49$",
        "$69$"
      ],
      "answer": 0,
      "explain": "$(a+b)^2=a^2+2ab+b^2$，所以 $a^2+b^2=(a+b)^2-2ab=49-20=29$。$39$ 是只減 $ab$，$69$ 是把 $2ab$ 加上去。答案是 $29$。",
      "codes": [
        "A-8-1"
      ]
    },
    {
      "id": "m8-05-q08",
      "level": 3,
      "tier": "exam",
      "concept": "乘法公式變形",
      "q": "計算 $(\\sqrt{3}+1)^2-(\\sqrt{3}-1)^2$ 的值。",
      "choices": [
        "$2$",
        "$8$",
        "$4\\sqrt{3}$",
        "$2\\sqrt{3}$"
      ],
      "answer": 2,
      "explain": "$(\\sqrt{3}+1)^2=4+2\\sqrt{3}$，$(\\sqrt{3}-1)^2=4-2\\sqrt{3}$，相減得 $4\\sqrt{3}$。也可以用平方差：$[(\\sqrt{3}+1)+(\\sqrt{3}-1)][(\\sqrt{3}+1)-(\\sqrt{3}-1)]=2\\sqrt{3}\\times 2=4\\sqrt{3}$。答案是 $4\\sqrt{3}$。",
      "codes": [
        "A-8-1",
        "N-8-1"
      ]
    }
  ],
