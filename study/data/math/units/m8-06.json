  "title": "多項式與其四則運算",
  "codes": [
    {
      "code": "A-8-2",
      "text": "多項式的意義：一元多項式的定義與相關名詞（多項式、項數、係數、常數項、一次項、二次項、最高次項、升冪、降冪）。"
    },
    {
      "code": "A-8-3",
      "text": "多項式的四則運算：直式、橫式的多項式加法與減法；直式的多項式乘法（乘積最高至三次）；被除式為二次之多項式的除法運算。"
    }
  ],
  "intro": "認識一元多項式的名詞（次數、係數、常數項、升冪、降冪），並學會多項式的加減、乘法（最高到三次）和二次多項式的除法。",
  "sections": [
    {
      "title": "多項式的名詞",
      "points": [
        "像 $3x^2-2x+5$ 由幾個單項式相加而成，叫一元多項式，$3x^2$、$-2x$、$5$ 是它的項。",
        "$x$ 的次方最高是 2，叫二次多項式；$3$ 是二次項係數，$-2$ 是一次項係數，$5$ 是常數項。",
        "係數要連同前面的正負號一起看。",
        "降冪：次數由高到低排；升冪：次數由低到高排。"
      ]
    },
    {
      "title": "加法與減法",
      "points": [
        "只有同類項（次數相同的項）才能合併，係數相加減。",
        "減一個括號，括號內每一項都要變號：$-(x^2-4x+2)=-x^2+4x-2$。",
        "直式運算時，同次項上下對齊，缺的次數留空位或補 0。"
      ]
    },
    {
      "title": "乘法",
      "points": [
        "用分配律把每一項乘到另一個多項式的每一項，再合併同類項。",
        "$x^m\\times x^n=x^{m+n}$，例如 $x\\times x^2=x^3$。",
        "例：$(x-2)(x^2+3x-1)=x^3+3x^2-x-2x^2-6x+2=x^3+x^2-7x+2$。"
      ]
    },
    {
      "title": "除法",
      "points": [
        "被除式、除式先排成降冪，用長除法一次消掉最高次項。",
        "關係式：被除式 $=$ 除式 $\\times$ 商式 $+$ 餘式。",
        "餘式的次數一定比除式小；餘式是 0 時叫整除。",
        "例：$(2x^2-5x+7)\\div(x-2)$，商式 $2x-1$，餘式 $5$，因為 $(x-2)(2x-1)+5=2x^2-5x+7$。"
      ]
    }
  ],
  "mustKnow": [
    {
      "name": "除法關係式",
      "body": "被除式 $=$ 除式 $\\times$ 商式 $+$ 餘式"
    },
    {
      "name": "餘式條件",
      "body": "餘式次數 < 除式次數，或餘式為 0（整除）"
    },
    {
      "name": "指數律",
      "body": "$x^m\\times x^n=x^{m+n}$"
    },
    {
      "name": "去括號變號",
      "body": "$-(a-b+c)=-a+b-c$"
    },
    {
      "name": "次數",
      "body": "多項式的次數＝最高次項的次數；不為 $0$ 的常數多項式是零次多項式"
    }
  ],
  "quiz": [
    {
      "id": "m8-06-q01",
      "level": 1,
      "tier": "basic",
      "concept": "多項式名詞",
      "q": "把多項式 $3x^2-5+2x-x^2$ 化簡並按降冪排列後，下列敘述何者正確？",
      "choices": [
        "二次項係數是 3",
        "一次項係數是 2",
        "常數項是 5",
        "它是三次多項式"
      ],
      "answer": 1,
      "explain": "合併同類項：$3x^2-x^2=2x^2$，化簡後是 $2x^2+2x-5$。二次項係數是 $2$（不是 3），一次項係數是 $2$，常數項是 $-5$（要帶負號），最高次是 2 次。答案是「一次項係數是 2」。",
      "codes": [
        "A-8-2"
      ]
    },
    {
      "id": "m8-06-q02",
      "level": 1,
      "tier": "basic",
      "concept": "多項式加法",
      "q": "計算 $(4x^2-3x+1)+(-x^2+5x-6)$ 的結果。",
      "choices": [
        "$3x^2+2x-5$",
        "$5x^2+2x-5$",
        "$3x^2-8x-5$",
        "$3x^2+2x+7$"
      ],
      "answer": 0,
      "explain": "同類項相加：$4x^2-x^2=3x^2$，$-3x+5x=2x$，$1-6=-5$。結果是 $3x^2+2x-5$。答案是 $3x^2+2x-5$。",
      "codes": [
        "A-8-3"
      ]
    },
    {
      "id": "m8-06-q03",
      "level": 1,
      "tier": "basic",
      "concept": "多項式減法",
      "q": "計算 $(2x^2+x-3)-(x^2-4x+2)$ 的結果。",
      "choices": [
        "$x^2-3x-1$",
        "$x^2+5x-1$",
        "$x^2+5x-5$",
        "$3x^2-3x-5$"
      ],
      "answer": 2,
      "explain": "去括號變號：$2x^2+x-3-x^2+4x-2=x^2+5x-5$。$x^2-3x-1$ 是後面括號忘了變號。答案是 $x^2+5x-5$。",
      "codes": [
        "A-8-3"
      ]
    },
    {
      "id": "m8-06-q04",
      "level": 2,
      "tier": "exam",
      "concept": "多項式乘法",
      "q": "計算 $(x-2)(x^2+3x-1)$ 的結果。",
      "choices": [
        "$x^3+x^2-7x+2$",
        "$x^3+5x^2+5x+2$",
        "$x^3+x^2-5x+2$",
        "$x^3+x^2-7x-2$"
      ],
      "answer": 0,
      "explain": "$x(x^2+3x-1)=x^3+3x^2-x$，$-2(x^2+3x-1)=-2x^2-6x+2$。相加：$x^3+x^2-7x+2$。常數項是 $(-2)\\times(-1)=+2$。答案是 $x^3+x^2-7x+2$。",
      "codes": [
        "A-8-3"
      ]
    },
    {
      "id": "m8-06-q05",
      "level": 2,
      "tier": "exam",
      "concept": "多項式除法",
      "q": "計算 $(6x^2+x-2)\\div(2x-1)$，商式是什麼？（已知可以整除）",
      "choices": [
        "$3x-2$",
        "$3x+1$",
        "$2x+3$",
        "$3x+2$"
      ],
      "answer": 3,
      "explain": "長除法：$6x^2\\div 2x=3x$，$3x(2x-1)=6x^2-3x$，相減得 $4x-2$；$4x\\div 2x=2$，$2(2x-1)=4x-2$，餘式 $0$。商式是 $3x+2$。驗算：$(2x-1)(3x+2)=6x^2+x-2$。答案是 $3x+2$。",
      "codes": [
        "A-8-3"
      ]
    },
    {
      "id": "m8-06-q06",
      "level": 2,
      "tier": "exam",
      "concept": "多項式除法",
      "q": "計算 $(2x^2-5x+7)\\div(x-2)$，下列何者正確？",
      "choices": [
        "商式 $2x-9$，餘式 $25$",
        "商式 $2x-1$，餘式 $5$",
        "商式 $2x+1$，餘式 $9$",
        "商式 $2x-1$，餘式 $-5$"
      ],
      "answer": 1,
      "explain": "$2x^2\\div x=2x$，$2x(x-2)=2x^2-4x$，相減得 $-x+7$；$-x\\div x=-1$，$-1\\times(x-2)=-x+2$，相減得餘式 $5$。驗算：$(x-2)(2x-1)+5=2x^2-5x+2+5=2x^2-5x+7$。答案是商式 $2x-1$，餘式 $5$。",
      "codes": [
        "A-8-3"
      ]
    },
    {
      "id": "m8-06-q07",
      "level": 3,
      "tier": "exam",
      "concept": "除法恆等式",
      "q": "多項式 $A$ 除以 $x+3$，得到商式 $2x-1$、餘式 $4$。$A$ 是什麼？",
      "choices": [
        "$2x^2+5x-7$",
        "$2x^2+5x-3$",
        "$2x^2-7x+1$",
        "$2x^2+5x+1$"
      ],
      "answer": 3,
      "explain": "被除式 $=$ 除式 $\\times$ 商式 $+$ 餘式：$A=(x+3)(2x-1)+4=2x^2-x+6x-3+4=2x^2+5x+1$。$2x^2+5x-7$ 是把餘式減掉，$2x^2+5x-3$ 是忘了加餘式。答案是 $2x^2+5x+1$。",
      "codes": [
        "A-8-3"
      ]
    },
    {
      "id": "m8-06-q08",
      "level": 3,
      "tier": "exam",
      "concept": "多項式應用",
      "q": "一塊長方形木板，長 $(2x+3)$ 公分、寬 $(x+1)$ 公分（$x>0$）。從木板上切掉一塊邊長 $x$ 公分的正方形後，剩下的面積是多少平方公分？",
      "choices": [
        "$x^2+3x+3$",
        "$2x^2+5x+3$",
        "$x^2+5x-3$",
        "$x^2+5x+3$"
      ],
      "answer": 3,
      "explain": "長方形面積 $=(2x+3)(x+1)=2x^2+2x+3x+3=2x^2+5x+3$。減去正方形 $x^2$：$2x^2+5x+3-x^2=x^2+5x+3$。$2x^2+5x+3$ 是忘了減正方形。答案是 $x^2+5x+3$。",
      "codes": [
        "A-8-3"
      ]
    }
  ],
